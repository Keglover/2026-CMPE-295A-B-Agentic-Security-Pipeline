# Copy to auth/.env.models with mode 0600, then fill in your own values.
# The CLI reads this file only when --model-env-file points to it.
JEV_MODEL_PROTOCOL=ollama
JEV_MODEL_URL=https://ollama.com
JEV_MODEL_NAME=deepseek-v4.1-flash
OLLAMA_API_KEY=

# OpenAI is the fallback scaffold. Leave key/model empty until it is available.
# Missing fallback setup never prevents a healthy primary request.
JEV_FALLBACK_MODEL_URL=https://api.openai.com/v1
JEV_FALLBACK_MODEL_NAME=
OPENAI_API_KEY=
