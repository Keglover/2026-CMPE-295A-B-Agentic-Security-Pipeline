# Auth0 scaffold: populate a native app with Device Code enabled and an API
# with RBAC plus permissions included in access tokens. No client secret.
JEV_AUTH_MODE=required
JEV_OIDC_PROVIDER=auth0
JEV_OIDC_ISSUER=https://YOUR_TENANT.auth0.com/
JEV_OIDC_CLIENT_ID=YOUR_PUBLIC_NATIVE_APP_CLIENT_ID
JEV_OIDC_AUDIENCE=YOUR_API_IDENTIFIER
# Register jev:evaluate, jev:tools:call, jev:approvals:write, jev:audit:read
# as API permissions. Assign approval permission only to reviewers.
