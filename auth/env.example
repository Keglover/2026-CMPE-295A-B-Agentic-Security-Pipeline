# Local development only. Run python auth/setup.py to create auth/.env.
PROMPTRAIL_KEYCLOAK_ADMIN_PASSWORD=
PROMPTRAIL_AUTH_MODE=required
PROMPTRAIL_OIDC_PROVIDER=keycloak
PROMPTRAIL_OIDC_ISSUER=http://127.0.0.1:8080/realms/promptrail
PROMPTRAIL_OIDC_CLIENT_ID=promptrail-cli
PROMPTRAIL_OIDC_AUDIENCE=promptrail-gateway
PROMPTRAIL_SELF_REGISTRATION_ENABLED=false
