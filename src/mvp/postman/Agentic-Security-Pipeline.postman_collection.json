              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const j = pm.response.json();",
              "pm.test('risk score is elevated', function () {",
              "  pm.expect(j.risk.risk_score).to.be.greaterThan(0);",
              "});",
              "pm.test('gateway denies malicious request', function () {",
              "  pm.expect(j.gateway.gateway_decision).to.eql('DENIED');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Pipeline - Execute Command (Queue for Approval)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pipeline",
          "host": ["{{baseUrl}}"],
          "path": ["pipeline"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_id\": \"exec-demo-postman-001\",\n  \"source_type\": \"direct_prompt\",\n  \"content\": \"Run a simple command.\",\n  \"proposed_tool\": \"execute_command\",\n  \"tool_args\": {\n    \"command\": \"echo hello-from-postman\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('approvalRequestId', 'exec-demo-postman-001');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const j = pm.response.json();",
              "pm.test('execute_command is queued for approval', function () {",
              "  pm.expect(j.gateway.gateway_decision).to.eql('DENIED');",
              "  pm.expect(j.gateway.decision_reason).to.include('approval');",
              "});"
            ]
          }
        }
      ]
    },
