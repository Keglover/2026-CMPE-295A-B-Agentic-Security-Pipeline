{
  "info": {
    "name": "Agentic Security Pipeline - Full API Tests",
    "description": "End-to-end Postman test collection for the full security pipeline lifecycle: health, tools, URL validation, pipeline actions, approval/replay, audit, and stats.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "description": "Base URL of the running pipeline API"
    },
    {
      "key": "approvalRequestId",
      "value": "exec-demo-static",
      "description": "Set dynamically by 07 before the execute_command request"
    },
    {
      "key": "rejectRequestId",
      "value": "reject-demo-static",
      "description": "Set dynamically by 11 before the reject candidate request"
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const j = pm.response.json();",
              "pm.test('health payload contains status', function () {",
              "  pm.expect(j).to.have.property('status');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Tools",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tools",
          "host": ["{{baseUrl}}"],
          "path": ["tools"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const j = pm.response.json();",
              "pm.test('allowed_tools present', function () {",
              "  pm.expect(j).to.have.property('allowed_tools');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Validate URLs - Allowed Domain",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/validate-urls",
          "host": ["{{baseUrl}}"],
          "path": ["validate-urls"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tool\": \"fetch_url\",\n  \"args\": {\n    \"url\": \"https://example.com\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const j = pm.response.json();",
              "pm.test('url validation response fields exist', function () {",
              "  pm.expect(j).to.have.property('urls');",
              "  pm.expect(j).to.have.property('blocked_count');",
              "  pm.expect(j).to.have.property('can_proceed');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Pipeline - Benign Summarize",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pipeline",
          "host": ["{{baseUrl}}"],
          "path": ["pipeline"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_id\": \"demo-benign-001\",\n  \"source_type\": \"direct_prompt\",\n  \"content\": \"summarize project abstract\",\n  \"proposed_tool\": \"summarize\",\n  \"tool_args\": {\n    \"text\": \"Large Language Models are increasingly deployed as agentic systems that can browse the web and call third-party tools.\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const j = pm.response.json();",
              "pm.test('pipeline trace fields exist', function () {",
              "  pm.expect(j).to.have.property('risk');",
              "  pm.expect(j).to.have.property('policy');",
              "  pm.expect(j).to.have.property('gateway');",
              "});",
              "pm.test('policy action is ALLOW', function () {",
              "  pm.expect(j.policy.policy_action).to.eql('ALLOW');",
              "});",
              "pm.test('gateway decision is EXECUTED', function () {",
              "  pm.expect(j.gateway.gateway_decision).to.eql('EXECUTED');",
              "});"
            ]
          }
        }
      ]
    },
